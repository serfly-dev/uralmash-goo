# Used to create the admin account only when it does not already exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
APP_ORIGIN=http://localhost:3000
# Public canonical origin used for metadata and sitemap; set to the production HTTPS site URL.
NEXT_PUBLIC_SITE_URL=
API_PORT=4000
# Keep the API on loopback behind a TLS-terminating proxy; use a private interface only when the proxy runs elsewhere.
API_HOST=localhost
# Internal API origin used by the server-rendered admin route.
API_INTERNAL_URL=http://localhost:4000
# Set a unique 32-byte key encoded as 64 hexadecimal characters.
REQUEST_ENCRYPTION_KEY=
# In production use HTTPS, or route /api and /media to the API through the TLS reverse proxy and leave this empty.
NEXT_PUBLIC_API_URL=
# If the API is behind a reverse proxy, list only its IP addresses or CIDRs; the proxy must replace forwarded client-IP headers.
API_TRUSTED_PROXIES=
# Total media upload storage limit in MiB (default 5120 MiB / 5 GiB).
MEDIA_STORAGE_LIMIT_MB=5120
# Optional SMTP notifications. Configure only with an SMTP service selected by the site owner.
MAIL_NOTIFICATIONS_ENABLED=false
# When enabled, requests are queued even if SMTP is incomplete; set the remaining values to deliver them.
# HTTPS APP_ORIGIN is required before the mail worker can run.
SMTP_HOST=
SMTP_PORT=
# true for implicit TLS (usually port 465); false requires STARTTLS (usually port 587).
SMTP_SECURE=
SMTP_USER=
# Use the mail provider's application password. Never commit real credentials.
SMTP_PASSWORD=
SMTP_FROM=
# Recipient for request notifications and admin password confirmation codes.
SMTP_TO=
